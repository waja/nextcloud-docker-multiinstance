[Unit]
Description=Nextcloud Service
After=network.target docker.service traefik.service
Requires=docker.service

[Service]
Type=oneshot                                                         
RemainAfterExit=yes

ExecStartPre=-/usr/bin/env -u NEXTCLOUD_VERSION -u COMPOSE_PROJECT_NAME /usr/local/bin/docker-compose -f "${WORK_DIR}/docker-compose.yml" -f "${WORK_DIR}/container.conf/production.yml" down
ExecStartPre=-/usr/bin/env -u NEXTCLOUD_VERSION -u COMPOSE_PROJECT_NAME /usr/local/bin/docker-compose -f "${WORK_DIR}/docker-compose.yml" -f "${WORK_DIR}/container.conf/production.yml" pull
ExecStart=/usr/bin/env -u NEXTCLOUD_VERSION -u COMPOSE_PROJECT_NAME /usr/local/bin/docker-compose -f "${WORK_DIR}/docker-compose.yml" -f "${WORK_DIR}/container.conf/production.yml" up -d
ExecStop=/usr/bin/env -u NEXTCLOUD_VERSION -u COMPOSE_PROJECT_NAME /usr/local/bin/docker-compose -f "${WORK_DIR}/docker-compose.yml" -f "${WORK_DIR}/container.conf/production.yml" down

[Install]
WantedBy=docker.service
